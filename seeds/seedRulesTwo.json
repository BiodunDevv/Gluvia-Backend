  {
    "slug": "ramadan-fasting-sahur",
    "title": "Ramadan Sahur (Pre-Dawn) Meal Guidelines",
    "type": "constraint",
    "definition": {
      "inputBindings": [
        "user.diabetesType",
        "meal.timeOfDay",
        "context.specialEvent"
      ],
      "logic": [
        {
          "when": "context.specialEvent === 'ramadan' && meal.timeOfDay === 'sahur'",
          "then": {
            "minCarbs_g": 40,
            "maxCarbs_g": 60,
            "minProtein_g": 20,
            "minFiber_g": 8,
            "preferLowGI": true,
            "reasonScore": 100,
            "severity": "high",
            "recommendation": "Focus on complex carbs (oats, brown rice, dates) and protein to sustain energy during fast"
          }
        },
        {
          "when": "default",
          "then": {
            "reasonScore": 0,
            "severity": "none"
          }
        }
      ],
      "priority": 95
    },
    "nlTemplate": "During Ramadan Sahur, aim for {{minCarbs_g}}-{{maxCarbs_g}}g of slow-release carbs with at least {{minProtein_g}}g protein. This will help maintain stable glucose throughout the day.",
    "appliesTo": ["all"],
    "version": 1
  },
