  {
    "slug": "hypoglycemia-prevention",
    "title": "Low Blood Sugar Prevention",
    "type": "alert",
    "definition": {
      "inputBindings": [
        "user.lastGlucose",
        "meal.totalCarbs",
        "user.medicationType"
      ],
      "logic": [
        {
          "when": "user.lastGlucose < 70",
          "then": {
            "alert": "hypoglycemia_risk",
            "severity": "critical",
            "reasonScore": 95,
            "action": "consume_fast_carbs"
          }
        },
        {
          "when": "user.lastGlucose < 90 && user.medicationType.includes('insulin')",
          "then": {
            "alert": "low_glucose_insulin",
            "severity": "high",
            "reasonScore": 80
          }
        },
        {
          "when": "default",
          "then": { "alert": "none", "severity": "low", "reasonScore": 0 }
        }
      ],
      "priority": 100
    },
    "nlTemplate": "Your glucose is {{user.lastGlucose}} mg/dL. Consider consuming 15-20g of fast-acting carbs immediately and recheck in 15 minutes.",
    "appliesTo": ["all"],
    "version": 1
  },
  {
