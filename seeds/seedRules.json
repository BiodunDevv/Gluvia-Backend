  {
    "slug": "whole-grain-preference",
    "title": "Whole Grain Recommendation",
    "type": "substitution",
    "definition": {
      "inputBindings": ["food.tags", "food.category"],
      "logic": [
        {
          "when": "food.category === 'Grains & Staples' && !food.tags.includes('whole-grain')",
