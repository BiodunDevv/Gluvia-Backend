[
  {
    "slug": "max-carb-per-meal",
    "title": "Maximum Carbohydrate Limit Per Meal",
    "type": "constraint",
    "definition": {
      "inputBindings": [
        "user.bmi",
        "user.lastGlucose",
        "meal.timeOfDay",
        "user.diabetesType"
      ],
      "logic": [
        {
          "when": "user.lastGlucose > 180",
          "then": { "maxCarbs_g": 30, "reasonScore": 100, "severity": "high" }
        },
        {
          "when": "user.bmi >= 30",
          "then": { "maxCarbs_g": 35, "reasonScore": 80, "severity": "medium" }
        },
        {
          "when": "user.diabetesType === 'type1'",
          "then": { "maxCarbs_g": 40, "reasonScore": 70, "severity": "medium" }
        },
        {
          "when": "default",
          "then": { "maxCarbs_g": 45, "reasonScore": 50, "severity": "low" }
        }
      ],
      "priority": 100
    },
    "nlTemplate": "Based on your last glucose reading of {{user.lastGlucose}} mg/dL, we recommend keeping total carbohydrates below {{maxCarbs_g}}g for this meal.",
    "appliesTo": ["all"],
    "version": 1
  },
  {
    "slug": "high-gi-warning",
    "title": "High Glycemic Index Food Warning",
    "type": "alert",
    "definition": {
      "inputBindings": ["food.gi", "user.diabetesType"],
      "logic": [
        {
          "when": "food.gi > 70",
          "then": { "alert": "high_gi", "severity": "high", "reasonScore": 90 }
        },
        {
          "when": "food.gi > 55 && food.gi <= 70",
          "then": {
            "alert": "medium_gi",
            "severity": "medium",
            "reasonScore": 60
          }
        },
        {
          "when": "default",
          "then": { "alert": "low_gi", "severity": "low", "reasonScore": 30 }
        }
      ],
      "priority": 90
    },
    "nlTemplate": "This food has a {{alert}} glycemic index ({{food.gi}}). Foods with high GI can cause rapid blood sugar spikes.",
    "appliesTo": ["all"],
    "version": 1
  },
  {
    "slug": "portion-size-adjustment",
    "title": "Portion Size Recommendation",
    "type": "portion_adjustment",
    "definition": {
      "inputBindings": ["user.bmi", "user.activityLevel", "meal.timeOfDay"],
      "logic": [
        {
          "when": "user.bmi >= 30",
          "then": { "portionMultiplier": 0.75, "reasonScore": 80 }
        },
        {
          "when": "user.activityLevel === 'high'",
          "then": { "portionMultiplier": 1.2, "reasonScore": 60 }
        },
        {
          "when": "meal.timeOfDay === 'dinner'",
          "then": { "portionMultiplier": 0.85, "reasonScore": 50 }
        },
        {
          "when": "default",
          "then": { "portionMultiplier": 1.0, "reasonScore": 40 }
        }
      ],
      "priority": 70
    },
    "nlTemplate": "For your activity level and BMI, we suggest adjusting this portion to {{adjustedPortion}}g.",
    "appliesTo": ["all"],
    "version": 1
  },
