    "version": 1
  },
  {
    "slug": "carb-to-fiber-ratio",
    "title": "Carbohydrate to Fiber Ratio Check",
    "type": "scoring",
    "definition": {
      "inputBindings": ["food.carbs_g", "food.fibre_g"],
      "logic": [
        {
          "when": "food.carbs_g > 0 && (food.fibre_g / food.carbs_g) > 0.15",
          "then": {
            "scoreBonus": 15,
            "priority": "excellent",
            "carbFiberRatio": "excellent"
          }
        },
        {
          "when": "food.carbs_g > 0 && (food.fibre_g / food.carbs_g) > 0.10",
          "then": {
            "scoreBonus": 10,
            "priority": "good",
            "carbFiberRatio": "good"
          }
        },
        {
          "when": "food.carbs_g > 20 && food.fibre_g < 2",
          "then": {
            "scoreBonus": -5,
            "priority": "poor",
            "carbFiberRatio": "poor"
          }
        },
        {
          "when": "default",
          "then": {
            "scoreBonus": 0,
            "priority": "neutral",
            "carbFiberRatio": "neutral"
          }
        }
      ],
      "priority": 77
    },
    "nlTemplate": "This food has a {{carbFiberRatio}} carb-to-fiber ratio. Higher fiber helps slow carbohydrate absorption.",
    "appliesTo": ["all"],
    "version": 1
  },
