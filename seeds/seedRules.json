        },
        {
          "when": "food.tags.includes('white-rice') || food.tags.includes('white-bread')",
          "then": {
            "suggestion": "refined_grain_warning",
            "severity": "high",
            "reasonScore": 85,
            "alternatives": ["Brown rice", "Whole grain bread"]
          }
        },
        {
          "when": "default",
          "then": { "suggestion": "none", "severity": "low", "reasonScore": 0 }
        }
      ],
      "priority": 82
    },
    "nlTemplate": "Consider swapping to whole grain options which have more fiber and nutrients, causing slower blood sugar rises.",
    "appliesTo": ["Grains & Staples"],
    "version": 1
  },
