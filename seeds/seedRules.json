    "version": 1
  },
  {
    "slug": "healthy-fat-balance",
    "title": "Healthy Fat Recommendation",
    "type": "scoring",
    "definition": {
      "inputBindings": ["food.fat_g", "food.tags", "food.category"],
      "logic": [
        {
          "when": "food.tags.includes('omega-3') || food.tags.includes('healthy-fat')",
          "then": { "scoreBonus": 18, "priority": "high" }
        },
        {
          "when": "food.category === 'Nuts & Seeds' && food.fat_g > 10",
          "then": { "scoreBonus": 12, "priority": "medium" }
        },
        {
          "when": "food.fat_g > 20 && food.tags.includes('saturated')",
          "then": { "scoreBonus": -15, "priority": "avoid" }
        },
        {
          "when": "default",
          "then": { "scoreBonus": 0, "priority": "neutral" }
        }
      ],
      "priority": 72
    },
    "nlTemplate": "This food contains healthy fats that can help with satiety and don't directly raise blood sugar.",
